// Prisma schema: https://pris.ly/d/prisma-schema
// The connection URL is set in prisma7.config.ts (DATABASE_URL), not here.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Attraction {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(255)
  detail     String @db.Text
  coverimage String @db.VarChar(2048)
  // DOUBLE keeps full GPS precision and comes back as a plain JS number.
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now())

  @@map("attractions")
}
